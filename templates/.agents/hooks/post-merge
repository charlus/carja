#!/usr/bin/env bash
# ============================================================
# Carja post-merge hook: cleanup after `git pull`.
#
# When the owner pulls, the MRs he merged on the forge arrive. A `carja
# loop` worktree, or an interactive item's (`carja work`, branch
# carja/work/), whose branch is now contained in the default branch is
# finished: remove it and its local branch, so nobody has to come back and say
# "it is merged". Conservative: only a branch provably merged
# (`merge-base --is-ancestor`), never a worktree with uncommitted changes, and
# never one that still holds a nested code worktree (the outer layout: that one
# goes when the code repository's own pull finds its branch merged).
# A squash-merged branch is not contained in the default branch, and the forge
# deletes it: then the forge decides (glab or gh), and only when its merged MR's
# head is the local branch head. A deleted remote branch alone is not a merge.
# Never a fresh loop branch (no commit of its own: its tip is on the default
# branch's first-parent line), and never a worktree a live loop run holds (its
# pid in carja-holder, in the worktree's own git directory): worktrees are
# shared by every checkout, so another loop's live work shows up here too.
# Cleanup only: it never blocks, and always exits 0.
# CARJA_HOOKS=off disables it, like every Carja hook.
# ============================================================
# 6.x names still work through 7.x: each CONDUCTOR_X sets CARJA_X when unset.
for _k in $(compgen -e); do case "$_k" in CONDUCTOR_*) _n="CARJA_${_k#CONDUCTOR_}"; [ -n "${!_n:-}" ] || export "$_n=${!_k}" ;; esac; done
[ "${CARJA_HOOKS:-on}" = "off" ] && exit 0

base="$(git rev-parse --abbrev-ref origin/HEAD 2>/dev/null)"
if [ -z "$base" ] || [ "$base" = "origin/HEAD" ]; then
  base=""
  for ref in origin/main origin/master main master; do
    if git rev-parse --verify -q "$ref" >/dev/null 2>&1; then base="$ref"; break; fi
  done
fi
[ -n "$base" ] || exit 0

# The head of the merged MR for branch $1, from the forge; empty when none or unknown.
# A forge that does not answer in 15 s never holds the pull.
forge_merged_head() {
  local url enc t=""
  command -v timeout >/dev/null 2>&1 && t="timeout 15"
  url="$(git remote get-url origin 2>/dev/null)" || return 0
  case "$url" in
    *github.com[:/]*)
      command -v gh >/dev/null 2>&1 || return 0
      $t gh pr list --head "$1" --state merged --json headRefOid --jq '.[0].headRefOid // empty' 2>/dev/null ;;
    *)
      command -v glab >/dev/null 2>&1 || return 0
      enc="$(printf '%s' "$1" | sed 's|/|%2F|g')"
      $t glab api "projects/:id/merge_requests?source_branch=${enc}&state=merged" 2>/dev/null \
        | grep -o '"sha":"[0-9a-f]\{40\}"' | head -1 | cut -d'"' -f4 ;;
  esac
}

own_line="$(git rev-list --first-parent "$base" 2>/dev/null)"

# A live loop run holds the worktree at $1.
held_by_live_run() {
  local dir pid
  dir="$(git -C "$1" rev-parse --path-format=absolute --git-dir 2>/dev/null)" || return 1
  [ -f "$dir/carja-holder" ] || return 1
  pid="$(grep -o '"pid":[0-9]*' "$dir/carja-holder" | head -1 | cut -d: -f2)"
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

# Merged: contained in the default branch, or squash-merged at the local head.
# A tip on the default branch's own line is a fresh branch, not a merged one.
loop_branch_merged() {
  local sha tip
  tip="$(git rev-parse "$1" 2>/dev/null)" || return 1
  if ! printf '%s\n' "$own_line" | grep -qx "$tip"; then
    git merge-base --is-ancestor "$1" "$base" 2>/dev/null && return 0
  fi
  sha="$(forge_merged_head "$1")"
  [ -n "$sha" ] && [ "$(git rev-parse "$1" 2>/dev/null)" = "$sha" ]
}

path="" branch=""
while IFS= read -r line; do
  case "$line" in
    "worktree "*) path="${line#worktree }"; branch="" ;;
    "branch refs/heads/carja/loop/"*|"branch refs/heads/carja/work/"*) branch="${line#branch refs/heads/}" ;;
    "")
      if [ -n "$branch" ] && [ "${path#*/.agents/.worktrees/}" != "$path" ] \
        && [ -z "$(git -C "$path" status --porcelain 2>/dev/null)" ] \
        && ! ls -d "$path"/*/.git >/dev/null 2>&1 \
        && ! held_by_live_run "$path" \
        && loop_branch_merged "$branch"; then
        if git worktree remove --force "$path" 2>/dev/null; then
          git branch -q -D "$branch" 2>/dev/null
          echo "Carja: removed the merged worktree ${path##*/} ($branch)."
        fi
      fi
      path="" branch="" ;;
  esac
done < <(git worktree list --porcelain 2>/dev/null; echo)
exit 0
