#!/usr/bin/env bash
# Carja — Verification Iron Law + Eval-Driven Law (run-gate), enforced at the
# push boundary (ADR-0001 D1). Verify: the project's verification command must pass.
# Eval: if the repo has evalsets and an eval command, they must pass too — presence
# was gated at commit; passing is gated here. No "should work" — proof or no push.
# Zero-run: a green verify whose output says no test ran is not green (A3).
# Integrity: a pushed commit whose message says [skip ci] is refused (A5).
# Review: a change of consequence needs a recorded independent APPROVE (7.2.0).
# Escapes (logged): CARJA_SKIP_VERIFY / CARJA_SKIP_EVAL / CARJA_NO_TESTS_RAN /
# CARJA_NO_INTEGRITY / CARJA_NO_REVIEW. Disable: CARJA_HOOKS=off.
set -uo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
[ -z "$ROOT" ] && exit 0
# 6.x names still work through 7.x: each CONDUCTOR_X sets CARJA_X when unset.
for _k in $(compgen -e); do case "$_k" in CONDUCTOR_*) _n="CARJA_${_k#CONDUCTOR_}"; [ -n "${!_n:-}" ] || export "$_n=${!_k}" ;; esac; done
# …and each CARJA_X sets CONDUCTOR_X, for a 6.x committed lib.sh (the push of the upgrade itself).
for _k in $(compgen -e); do case "$_k" in CARJA_*) _n="CONDUCTOR_${_k#CARJA_}"; [ -n "${!_n:-}" ] || export "$_n=${!_k}" ;; esac; done
[ "${CARJA_HOOKS:-on}" = "off" ] && exit 0

# Heartbeat: `carja status` compares it with the reflog to name the commits
# and pushes that skipped this hook (--no-verify, CARJA_HOOKS=off, a client
# that ignores hooks). Written here, not in lib.sh, so the commit that upgrades
# the hooks has one too.
HB_DIR="$(git rev-parse --git-common-dir 2>/dev/null || true)"
case "$HB_DIR" in "") ;; /*) ;; *) HB_DIR="$(pwd)/$HB_DIR" ;; esac
# A clone that got the rename to Carja by a pull still has the 6.x names (7.0.1).
if [ -n "$HB_DIR" ]; then for _f in heartbeat loop-logs loop-ready.json holder; do
  [ -e "$HB_DIR/conductor-$_f" ] && [ ! -e "$HB_DIR/carja-$_f" ] && mv "$HB_DIR/conductor-$_f" "$HB_DIR/carja-$_f" 2>/dev/null || true
done
  # Both heartbeats (install-hooks wrote the new one first): old history first (7.0.2).
  if [ -f "$HB_DIR/conductor-heartbeat" ] && [ -f "$HB_DIR/carja-heartbeat" ]; then
    cat "$HB_DIR/conductor-heartbeat" "$HB_DIR/carja-heartbeat" > "$HB_DIR/carja-heartbeat.tmp" 2>/dev/null \
      && mv "$HB_DIR/carja-heartbeat.tmp" "$HB_DIR/carja-heartbeat" && rm -f "$HB_DIR/conductor-heartbeat" || true
  fi
fi
[ -n "$HB_DIR" ] && printf '%s pre-push\n' "$(date +%s)" >> "$HB_DIR/carja-heartbeat" 2>/dev/null || true

# ---- The project root: where .agents/, carja/ and the config live -------
# It is ROOT, except in the outer layout. There a gitignored nested code
# repository has core.hooksPath set to the outer .agents/hooks by absolute path
# (`carja install-hooks`). The gates then judge the code repository's diff,
# and the library, the config and the ship-log come from the outer repository.
# The library is read from the outer repository's COMMITTED copy, which no
# commit or push in the code repository can rewrite.
PROJECT_ROOT="$ROOT"
NESTED_REPO=""
carja_find_project_root() {
  local home common main rel
  home="$(cd "$(dirname "$0")/../.." 2>/dev/null && pwd -P)" || return 0
  [ -n "$home" ] && [ "$home" != "$(cd "$ROOT" && pwd -P)" ] || return 0
  [ -d "$home/.agents/hooks" ] && [ -d "$home/carja" ] || return 0
  common="$(git -C "$ROOT" rev-parse --git-common-dir 2>/dev/null)" || return 0
  case "$common" in /*) ;; *) common="$ROOT/$common" ;; esac
  main="$(cd "$common/.." 2>/dev/null && pwd -P)" || return 0
  rel="${main#"$home"/}"
  [ "$rel" != "$main" ] || return 0             # not inside the project
  case "$rel" in */*|.git|"") return 0 ;; esac  # top-level directories only, never .git/modules
  PROJECT_ROOT="$home"
  NESTED_REPO="$rel"
}
carja_find_project_root

# The fingerprint of the pre-commit released WITH this pre-push. An edit to
# pre-commit that lands on exactly this content is an upgrade, not a neutering,
# and needs no waiver at push. Forging a match means editing pre-push as well —
# both entry scripts, the stated limit. Pinned by test/hooks-registry-drift.test.js.
CARJA_OFFICIAL_PRECOMMIT_SHA256="d95d6884f4fca16dcd85f6a12d624f4424bb09dd3e7a81b417bb686b3ba4bbbc"

# git feeds one line per pushed ref: <local ref> <local sha> <remote ref> <remote sha>.
PUSH_LINES="$(cat)"
ZERO="0000000000000000000000000000000000000000"

# ---- Load the shared library from a copy the change cannot rewrite ----------
# Both hooks source lib.sh, which makes it the single point that switches every
# gate off. Two versions of this got it wrong, both found by independent review:
#   1. sourcing the WORKING-TREE copy: deleting, moving or rewriting lib.sh
#      disabled every gate for the very commit doing it (round 1, B1);
#   2. sourcing the working-tree copy FIRST and the committed copy on top: any
#      top-level statement still ran — one `exit 0` switched everything off,
#      and `readonly -f` stopped the trusted copy redefining a helper (delta).
# So: once a lib.sh is COMMITTED, only the committed copy is sourced. The
# working-tree copy is never executed. It is used only when nothing has been
# committed yet — a fresh install, where there is no gate to weaken.
#
# The limit, stated rather than implied: this protects the LIBRARY. git runs the
# hook ENTRY SCRIPTS (pre-commit, pre-push) from the working tree, so a change
# that rewrites both runs the rewritten versions. Removing or disabling
# pre-commit is caught at pre-push below; rewriting both entry scripts defeats
# every client-side hook, and the backstop for that is the PR gate and the
# loop's Checker, not this file.
# A trusted lib.sh committed under 6.x names its helpers conductor_*. Through
# 7.x it is still the trusted copy (the remote's, at the push of the upgrade
# itself): give each helper its carja_* name rather than failing closed.
carja_compat_old_lib() {
  local f
  for f in $(compgen -A function conductor_); do
    type "carja_${f#conductor_}" >/dev/null 2>&1 || eval "carja_${f#conductor_}() { $f \"\$@\"; }"
  done
}

carja_load_lib() {
  local ref="$1" tmp
  if [ -n "$ref" ] && git -C "$PROJECT_ROOT" cat-file -e "$ref:.agents/hooks/lib.sh" 2>/dev/null; then
    tmp="$(mktemp 2>/dev/null)" || return 1
    if ! git -C "$PROJECT_ROOT" show "$ref:.agents/hooks/lib.sh" > "$tmp" 2>/dev/null; then
      rm -f "$tmp"
      return 1
    fi
    # shellcheck source=/dev/null
    . "$tmp"
    rm -f "$tmp"
    carja_compat_old_lib
    return 0
  fi
  [ -f "$PROJECT_ROOT/.agents/hooks/lib.sh" ] || return 1
  # shellcheck source=/dev/null
  . "$PROJECT_ROOT/.agents/hooks/lib.sh"
  carja_compat_old_lib
}

# Every helper `$1` needs, or the names that are missing. A committed lib.sh
# older than this hook (mid-upgrade) lacks the newer helpers; running on with
# them undefined would silently skip their gates, so a gap fails closed instead.
carja_missing_helpers() {
  local fn missing=""
  for fn in $1; do
    type "$fn" >/dev/null 2>&1 || missing="$missing $fn"
  done
  printf '%s' "${missing# }"
}

# Minimal ship-log writer for the one path where lib.sh could not be loaded,
# so even that waiver is recorded rather than silent.
carja_log_waiver_fallback() {
  local log="$PROJECT_ROOT/carja/0-compass/ship-log.md"
  [ -f "$log" ] || return 0
  printf -- '- [%s] Hook waiver (%s): %s\n' "$(date '+%Y-%m-%d %H:%M')" "$1" "$2" >> "$log"
}

# The trusted copy is what the REMOTE already has: at push time HEAD is the
# very commit being judged. Fall back to HEAD only when the remote has nothing.
TRUSTED_REF=""
while read -r _lref _lsha _rref rsha; do
  if [ -n "${rsha:-}" ] && [ "$rsha" != "$ZERO" ] && git -C "$ROOT" cat-file -e "$rsha" 2>/dev/null; then
    TRUSTED_REF="$rsha"
    break
  fi
done <<< "$PUSH_LINES"
# A brand-new branch has no remote sha: trust its merge-base with anything a
# remote already has, and HEAD only when there is no remote history at all.
if [ -z "$TRUSTED_REF" ]; then
  for r in $(git -C "$ROOT" for-each-ref --format='%(objectname)' refs/remotes 2>/dev/null); do
    mb="$(git -C "$ROOT" merge-base HEAD "$r" 2>/dev/null)" && [ -n "$mb" ] && { TRUSTED_REF="$mb"; break; }
  done
fi
[ -z "$TRUSTED_REF" ] && git -C "$ROOT" rev-parse --verify -q HEAD >/dev/null 2>&1 && TRUSTED_REF="HEAD"

# In the outer layout the library comes from the outer repository's HEAD: the
# refs being pushed belong to the code repository and hold no library.
LIB_REF="$TRUSTED_REF"
if [ -n "$NESTED_REPO" ]; then
  LIB_REF=""
  git -C "$PROJECT_ROOT" rev-parse --verify -q HEAD >/dev/null 2>&1 && LIB_REF="HEAD"
fi

REQUIRED="carja_verify_cmd carja_eval_cmd carja_has_eval_files carja_log_waiver"
lib_ok=1
carja_load_lib "$LIB_REF" || lib_ok=0
missing="$(carja_missing_helpers "$REQUIRED")"

if [ "$lib_ok" = "0" ] || [ -n "$missing" ]; then
  # Nothing loadable. If the remote had Carja, this push is removing it.
  if [ -n "$LIB_REF" ] && git -C "$PROJECT_ROOT" cat-file -e "$LIB_REF:.agents/hooks/lib.sh" 2>/dev/null; then
    if [ -n "${CARJA_NO_PROTECTED:-}" ]; then
      carja_log_waiver_fallback "Protected" "$CARJA_NO_PROTECTED"
      echo "⚠️  Carja enforcement library unavailable — WAIVED: $CARJA_NO_PROTECTED"
      exit 0
    fi
    echo "🛑 Carja — the committed enforcement library cannot run this hook; push blocked."
    echo "   If you are deliberately removing or upgrading Carja: CARJA_NO_PROTECTED=\"why\" git push …"
    exit 1
  fi
  exit 0
fi

# ---- A gate that could not judge its own removal ---------------------------
# git runs pre-commit from the working tree, so a commit that DELETES it runs
# no commit gate at all (independent review, blocker B1). This is the first
# boundary left that can see it: refuse to push a range that deletes a hook
# entry script unless the removal is stated.
removed_hooks=""
# Read the RAW diff so a rename and a mode change are visible, not only a
# deletion: `git mv pre-commit pre-commit.disabled` is status R, and
# `chmod -x pre-commit` is a mode change git obeys by silently skipping the
# hook. Both disable it as surely as deleting it (delta review, B1).
#
# An EDITED pre-commit counts too (final review, NB1): git runs the edited
# copy, so a pre-commit rewritten to `exit 0` judged its own commit and passed
# it — with a deleted test in the same commit. The two entry scripts cover each
# other: pre-commit (running the committed library) blocks an edit to pre-push
# at commit time, and pre-push blocks an edit to pre-commit here. Editing BOTH
# defeats any client-side hook; that is the stated limit.
blob_sha256() {
  # $1 = commit, $2 = path. Hashes the COMMITTED blob's raw bytes, piped
  # straight through: capturing it in a variable first strips trailing
  # newlines, which would make this disagree with the drift test for any file
  # not ending in exactly one. Line-ending conversion on checkout cannot touch
  # a blob. A read failure hashes nothing and so never matches (fail-safe).
  if command -v sha256sum >/dev/null 2>&1; then git -C "$ROOT" show "$1:$2" 2>/dev/null | sha256sum | cut -d' ' -f1
  elif command -v shasum >/dev/null 2>&1; then git -C "$ROOT" show "$1:$2" 2>/dev/null | shasum -a 256 | cut -d' ' -f1
  else git -C "$ROOT" show "$1:$2" 2>/dev/null | openssl dgst -sha256 | awk '{print $NF}'
  fi
}
hook_changes() {
  local from="$1" to="$2" line path
  git -C "$ROOT" diff --raw -M "$from" "$to" -- .agents/hooks/ 2>/dev/null | awk -F'\t' '
    { split($1, m, " "); nm = m[2]; st = substr(m[5], 1, 1); p = $2; q = $3
      if (st == "D") print p " (deleted)"
      else if (st == "R") print p " (renamed to " q ")"
      else if (p ~ /\/pre-(commit|push)$/ && (st == "T" || nm != "100755")) print p " (no longer executable)"
      else if (p ~ /\/pre-commit$/ && st == "M") print "__EDITED__\t" p }' |
    while IFS= read -r line; do
      case "$line" in
        __EDITED__*)
          path="${line#*$'\t'}"
          # The official pre-commit for this release is an upgrade: let it through.
          [ "$(blob_sha256 "$to" "$path")" = "$CARJA_OFFICIAL_PRECOMMIT_SHA256" ] && continue
          printf '%s (edited — the edited copy judged its own commit)\n' "$path"
          ;;
        *) printf '%s\n' "$line" ;;
      esac
    done
}
while read -r _lref lsha _rref rsha; do
  [ -z "${lsha:-}" ] || [ "$lsha" = "$ZERO" ] && continue
  from="$rsha"
  [ -z "${from:-}" ] || [ "$from" = "$ZERO" ] && from="$TRUSTED_REF"
  [ -z "$from" ] && continue
  while IFS= read -r f; do
    [ -n "$f" ] && removed_hooks="$removed_hooks\n    - $f"
  done <<< "$(hook_changes "$from" "$lsha")"
done <<< "$PUSH_LINES"

if [ -n "$removed_hooks" ]; then
  if [ -n "${CARJA_NO_PROTECTED:-}" ]; then
    carja_log_waiver "$PROJECT_ROOT" "Protected" "$CARJA_NO_PROTECTED"
    echo "⚠️  Carja hook removal WAIVED: $CARJA_NO_PROTECTED"
    echo "    (logged to carja/0-compass/ship-log.md)"
  else
    echo ""
    echo "🛑 Carja — this push removes or disables an enforcement hook; push blocked."
    echo -e "$removed_hooks"
    echo ""
    echo "  A deleted pre-commit runs no commit gate at all, so the commit that"
    echo "  removed it was never judged. If the removal is deliberate, say so:"
    echo "    CARJA_NO_PROTECTED=\"why\" git push …"
    echo ""
    exit 1
  fi
fi

# ---- Verification Iron Law ------------------------------------------------
# ---- A push that changes only carja/ proves nothing by running tests ----
# carja/ is project state: backlog, specs, ship-log. Running the suite and
# live evals for a backlog edit cost minutes and failed on flaky evals. Any file
# outside carja/, or a range that cannot be computed, counts as code.
code_in_push=0; ranges=0
while read -r _lref lsha _rref rsha; do
  [ -z "${lsha:-}" ] || [ "$lsha" = "$ZERO" ] && continue
  ranges=$((ranges+1))
  from="$rsha"
  [ -z "${from:-}" ] || [ "$from" = "$ZERO" ] && from="$TRUSTED_REF"
  if [ -z "$from" ] || [ "$from" = "HEAD" ]; then code_in_push=1; break; fi
  changed="$(git -C "$ROOT" diff --name-only "$from" "$lsha" 2>/dev/null)" || { code_in_push=1; break; }
  if printf '%s\n' "$changed" | grep -v '^$' | grep -qv '^carja/'; then code_in_push=1; break; fi
done <<< "$PUSH_LINES"
[ "$ranges" = "0" ] && code_in_push=1   # nothing to compare: judge as before
if [ "$code_in_push" = "0" ]; then
  echo "ℹ️  Carja: this push changes only carja/ — no verify, no evals."
  echo "✅ Push allowed."
  exit 0
fi

# ---- Gate integrity: a commit that switches CI off ------------------------
# `[skip ci]` in a pushed commit's message means the pipeline never judges it
# (A5, gstack RH-14). It never appeared in four real projects' history. These
# checks live here, not in lib.sh: the push of an upgrade loads the REMOTE's
# older library, and a helper missing there must not block every upgrade.
skip_ci=""
while read -r _lref lsha _rref rsha; do
  [ -z "${lsha:-}" ] || [ "$lsha" = "$ZERO" ] && continue
  from="$rsha"
  [ -z "${from:-}" ] || [ "$from" = "$ZERO" ] && from="$TRUSTED_REF"
  [ -z "$from" ] && continue
  while IFS=$'\t' read -r sha subj; do
    [ -n "$sha" ] && skip_ci="$skip_ci\n    - ${sha:0:9} $subj"
  done <<< "$(git -C "$ROOT" log --format='%H%x09%s%x09%b%x1e' "$from..$lsha" 2>/dev/null |
    tr '\n' ' ' | tr '\036' '\n' | sed 's/^ *//' |
    grep -Ei '\[(skip ci|ci skip|no ci|skip actions|actions skip)\]|\*\*\*NO_CI\*\*\*' | cut -f1,2)"
done <<< "$PUSH_LINES"
if [ -n "$skip_ci" ]; then
  if [ -n "${CARJA_NO_INTEGRITY:-}" ]; then
    carja_log_waiver "$PROJECT_ROOT" "Integrity" "$CARJA_NO_INTEGRITY"
    echo "⚠️  Carja gate integrity ([skip ci]) WAIVED: $CARJA_NO_INTEGRITY"
    echo "    (logged to carja/0-compass/ship-log.md)"
  else
    echo ""
    echo "🛑 Carja gate integrity — push blocked."
    echo ""
    echo "  These commits tell CI not to run:"
    echo -e "$skip_ci"
    echo ""
    echo "  Reword them (git rebase, then reword), or if skipping CI is deliberate:"
    echo "    CARJA_NO_INTEGRITY=\"why\" git push …"
    echo ""
    exit 1
  fi
fi

# ---- Review gate (7.2.0): no unreviewed change of consequence leaves -------
# The independent review is the step that catches most (an audit of one
# production project's review records, 2026-11-06: 1 wrong finding in 142
# blockers), and the step agents skipped most when only prose asked for it. A change above the
# review skill's own threshold (50 changed non-test lines, or any risk path)
# needs an APPROVE recorded for the pushed commit, or for an earlier commit
# when everything after it is carja/ state or Markdown (the ship-log commit
# after the review). `carja review-log verdict APPROVE` records it; the loop
# records its Checker's approval itself. Inline, not in lib.sh: the push of
# an upgrade loads the remote's older library.
REVIEW_FILE="${HB_DIR:+$HB_DIR/carja-review-verdicts}"
REVIEW_REMOTE="${1:-origin}"
carja_review_ignored() { grep -Ev '^(carja|conductor|\.agents)/|(^|/)AGENTS\.md$|\.md$|^$'; }
carja_review_is_test() { grep -Eq '(^|/)(tests?|__tests__|specs?|e2e)/|(^|/)test_[^/]*$|_test\.[A-Za-z]+$|\.(test|spec)\.[A-Za-z]+$|(^|/)conftest\.py$'; }
carja_review_risk() { grep -Ei '(^|/)(auth|authn|authz|oauth|authentication|authorization|login|sessions?|permissions?|security|secrets?|payments?|billing|migrations?|alembic)([/._-]|$)|(^|/)\.github/workflows/|(^|/)\.gitlab-ci\.yml$' | head -1; }
# carja_review_size <from> <to>: "<changed non-test lines of code>\t<first risk path>".
carja_review_size() {
  local a d f lines=0 files
  files="$(git -C "$ROOT" diff --name-only "$1" "$2" 2>/dev/null | carja_review_ignored)"
  while IFS=$'\t' read -r a d f; do
    [ -z "${f:-}" ] && continue
    printf '%s\n' "$f" | carja_review_ignored | grep -q . || continue
    printf '%s\n' "$f" | carja_review_is_test && continue
    case "$a$d" in *-*) continue ;; esac   # binary
    lines=$((lines + a + d))
  done <<< "$(git -C "$ROOT" diff --numstat "$1" "$2" 2>/dev/null)"
  printf '%s\t%s' "$lines" "$(printf '%s\n' "$files" | carja_review_risk)"
}
carja_review_needed() { local n r; IFS=$'\t' read -r n r <<< "$1"; [ "${n:-0}" -ge 50 ] || [ -n "$r" ]; }
carja_review_approved() {
  # $1 = pushed sha. An APPROVE for it, or for an ancestor after which the
  # added code alone is below the threshold (an IMPORTANT fixed after the
  # verdict, the ship-log commit): what the review skill would not review.
  local lsha="$1" sha rest
  [ -n "$REVIEW_FILE" ] && [ -f "$REVIEW_FILE" ] || return 1
  while IFS=$'\t' read -r sha rest; do
    case "$rest" in APPROVE*) ;; *) continue ;; esac
    [ "$sha" = "$lsha" ] && return 0
    git -C "$ROOT" merge-base --is-ancestor "$sha" "$lsha" 2>/dev/null || continue
    carja_review_needed "$(carja_review_size "$sha" "$lsha")" || return 0
  done < "$REVIEW_FILE"
  return 1
}
review_missing=""
review_default="$(git -C "$ROOT" symbolic-ref --short "refs/remotes/$REVIEW_REMOTE/HEAD" 2>/dev/null)"
if [ -z "$review_default" ]; then
  for _b in main master; do
    git -C "$ROOT" rev-parse --verify -q "refs/remotes/$REVIEW_REMOTE/$_b" >/dev/null 2>&1 && { review_default="$REVIEW_REMOTE/$_b"; break; }
  done
fi
while read -r _lref lsha rref rsha; do
  [ -z "${lsha:-}" ] || [ "$lsha" = "$ZERO" ] && continue
  # The change under review: since the default branch, or since the remote's
  # tip when the push goes to the default branch itself.
  base=""
  if [ -n "$review_default" ] && [ "$rref" != "refs/heads/${review_default#*/}" ]; then
    base="$(git -C "$ROOT" merge-base "$lsha" "$review_default" 2>/dev/null)"
  fi
  if [ -z "$base" ]; then
    base="$rsha"
    { [ -z "${base:-}" ] || [ "$base" = "$ZERO" ]; } && base="$TRUSTED_REF"
  fi
  { [ -z "$base" ] || [ "$base" = "HEAD" ]; } && continue   # nothing to compare: a first push
  [ "$base" = "$lsha" ] && continue
  size="$(carja_review_size "$base" "$lsha")"
  carja_review_needed "$size" || continue
  carja_review_approved "$lsha" && continue
  IFS=$'\t' read -r lines risk <<< "$size"
  review_missing="$review_missing\n    - ${lsha:0:9}: $lines changed lines of code since ${base:0:9}${risk:+, risk path $risk}"
done <<< "$PUSH_LINES"
if [ -n "$review_missing" ]; then
  if [ -n "${CARJA_NO_REVIEW:-}" ]; then
    carja_log_waiver "$PROJECT_ROOT" "Review" "$CARJA_NO_REVIEW"
    echo "⚠️  Carja review gate WAIVED: $CARJA_NO_REVIEW"
    echo "    (logged to carja/0-compass/ship-log.md)"
  else
    echo ""
    echo "🛑 Carja review gate — no independent review recorded; push blocked."
    echo -e "$review_missing"
    echo ""
    echo "  Run Ship's independent review (.agents/workflows/ship.md, Phase 4)."
    echo "  When it returns APPROVE, record it and push again:"
    if [ -n "$NESTED_REPO" ]; then
      echo "    carja review-log verdict APPROVE --repo $NESTED_REPO"
    else
      echo "    carja review-log verdict APPROVE"
    fi
    echo "  Or say why this change ships unreviewed:"
    echo "    CARJA_NO_REVIEW=\"why\" git push …"
    echo ""
    exit 1
  fi
fi

# ---- Zero-run detection (A3) ----------------------------------------------
# Echo what a verify run's output says about how many tests ran: "some", "0",
# or "unknown". A positive count anywhere wins (a verify of two suites where
# one is empty still ran tests). An unrecognised output is "unknown" and
# passes, as before: only a runner that SAYS it ran nothing is refused.
# Summary lines matched: pytest, jest, vitest, node --test, mocha, bun, go
# test, unittest, cargo, rspec. Colour codes are stripped first.
carja_tests_ran() {
  local esc; esc="$(printf '\033')"
  if LC_ALL=C sed "s/${esc}\[[0-9;]*[A-Za-z]//g" "$1" 2>/dev/null | LC_ALL=C grep -Eq \
    '(^|[^0-9])[1-9][0-9]* (passed|passing|pass)([^A-Za-z]|$)|(#|ℹ) (tests|pass) [1-9]|^ok[[:space:]]|Ran [1-9][0-9]* tests?|test result: ok\. [1-9]|(^|[^0-9])[1-9][0-9]* examples?, '; then
    echo some; return 0
  fi
  if LC_ALL=C sed "s/${esc}\[[0-9;]*[A-Za-z]//g" "$1" 2>/dev/null | LC_ALL=C grep -Eq \
    'collected 0 items|no tests ran|No tests found|No test files found|No test suites found|(#|ℹ) tests 0([^0-9]|$)|Ran 0 tests|\[no test files\]|(^|[^0-9])0 passing|running 0 tests|(^|[^0-9])0 examples?([^A-Za-z]|$)|(^|[^0-9])0 selected|Tests:[[:space:]]+0 total'; then
    echo 0; return 0
  fi
  echo unknown
}

cmd="$(carja_verify_cmd "$ROOT" "$PROJECT_ROOT" "$NESTED_REPO")"
if [ "$cmd" = "none" ]; then
  # A DECLARED off (`carja verify --none`). Silent on purpose: a docs or
  # state repo has nothing to run, and a warning it can never clear is how a
  # safety message gets trained out of the reader.
  :
elif [ -z "$cmd" ]; then
  echo "ℹ️  Carja: push gate OFF — no verification command, so this push proves nothing."
  if [ -n "$NESTED_REPO" ]; then
    echo "    Set it, in $PROJECT_ROOT:"
    echo "      carja verify --repo $NESTED_REPO --set \"npm test\"   (the command that proves this repository works)"
    echo "      carja verify --repo $NESTED_REPO --none"
  else
    echo "    Set it:        carja verify --set \"npm test\"    (the command that proves this project works)"
    echo "    Or declare it: carja verify --none               (nothing to verify in this repo)"
  fi
elif [ -n "${CARJA_SKIP_VERIFY:-}" ]; then
  carja_log_waiver "$PROJECT_ROOT" "VERIFY" "$CARJA_SKIP_VERIFY"
  echo "⚠️  Carja Verification Iron Law WAIVED: $CARJA_SKIP_VERIFY"
  echo "    (logged to carja/0-compass/ship-log.md)"
else
  # ---- Evidence ledger fast path (E2) ------------------------------------
  # If this EXACT command already ran green against this EXACT working-tree
  # content, re-running it proves nothing new. `carja evidence check` binds
  # freshness to a content fingerprint, so committing the tested code keeps its
  # evidence FRESH while any source change invalidates it.
  #
  # Strictly opt-out and strictly fail-safe: no `carja` on PATH, no ledger,
  # any doubt at all → we run the command. The ledger can only ever SKIP a
  # redundant run; it can never satisfy the gate on its own.
  fresh=0
  if [ "${CARJA_EVIDENCE:-on}" != "off" ] && { command -v carja >/dev/null 2>&1 || command -v conductor >/dev/null 2>&1; }; then
    # Allow-list: a release-note or version edit between the test run and the
    # push is not a behaviour change. Deliberately SMALL and never a source
    # path — override with CARJA_EVIDENCE_ALLOW_PATHS if your release flow
    # touches other non-source files.
    allow="${CARJA_EVIDENCE_ALLOW_PATHS:-CHANGELOG.md,VERSION}"
    if ( cd "$ROOT" && carja evidence check --label verify --expect-cmd "$cmd" --allow-paths "$allow" >/dev/null 2>&1 ); then
      fresh=1
    fi
  fi

  if [ "$fresh" = "1" ]; then
    echo "✅ Verification FRESH — this exact command already passed against this exact content."
    echo "   (evidence ledger; re-run anyway with CARJA_EVIDENCE=off)"
  else
    echo "🔬 Carja Verification Iron Law — running: $cmd"
    # Wrap the run so the result is recorded and the next push can trust it.
    # The wrapper never turns a red suite green. --stable-tree fails a green
    # run that changed files while it ran: the code that passed is not on disk.
    if [ "${CARJA_EVIDENCE:-on}" != "off" ] && { command -v carja >/dev/null 2>&1 || command -v conductor >/dev/null 2>&1; }; then
      runner() { ( cd "$ROOT" && carja evidence run --label verify --stable-tree -- "$cmd" ); }
    else
      runner() { ( cd "$ROOT" && eval "$cmd" ); }
    fi
    out_file="$(mktemp 2>/dev/null || true)"
    if [ -n "$out_file" ]; then
      runner 2>&1 | tee "$out_file"
      rc="${PIPESTATUS[0]}"
    else
      runner; rc=$?
    fi
    ran="unknown"
    [ "$rc" = "0" ] && [ -n "$out_file" ] && ran="$(carja_tests_ran "$out_file")"
    rm -f "$out_file" 2>/dev/null
    if [ "$rc" = "0" ] && [ "$ran" = "0" ]; then
      if [ -n "${CARJA_NO_TESTS_RAN:-}" ]; then
        carja_log_waiver "$PROJECT_ROOT" "Tests ran" "$CARJA_NO_TESTS_RAN"
        echo "⚠️  Carja zero-run check WAIVED: $CARJA_NO_TESTS_RAN"
        echo "    (logged to carja/0-compass/ship-log.md)"
      else
        # The wrapper recorded this run as green evidence: overwrite it, or the
        # next push finds it FRESH and skips the run.
        if [ "${CARJA_EVIDENCE:-on}" != "off" ] && command -v carja >/dev/null 2>&1; then
          ( cd "$ROOT" && carja evidence run --label verify -- "echo 'Carja: the verify ran no test' >&2; exit 1" ) >/dev/null 2>&1 || true
        fi
        echo ""
        echo "🛑 Verification ran no test — push blocked."
        echo "   It exited 0, but its output says no test ran: a renamed test folder, a"
        echo "   filter that matches nothing, or --passWithNoTests. Green with zero tests"
        echo "   proves nothing. Fix the command (carja verify --set \"…\"), or say why:"
        echo "     CARJA_NO_TESTS_RAN=\"why\" git push …"
        exit 1
      fi
    fi
    if [ "$rc" = "0" ]; then
      echo "✅ Verification passed."
    else
      echo ""
      echo "🛑 Verification FAILED — push blocked."
      echo "   Fix it, or bypass explicitly: CARJA_SKIP_VERIFY=\"why\" git push …"
      exit 1
    fi
  fi
fi

# ---- Eval-Driven Law (run-gate) -------------------------------------------
# Presence was enforced at commit; here the evalsets must actually pass. Only
# engages when the repo has evalsets — non-LLM projects never see it.
if carja_has_eval_files "$ROOT"; then
  eval_cmd="$(carja_eval_cmd "$ROOT" "$PROJECT_ROOT" "$NESTED_REPO")"
  if [ "$eval_cmd" = "none" ]; then
    :   # declared: these evals are run by hand, not on push
  elif [ -z "$eval_cmd" ]; then
    echo "ℹ️  Carja: evalsets exist but no eval command is configured — the Eval-Driven Law run-gate is NOT enforced on this push. Add \"eval\" to carja.config.json (e.g. \"eval\": \"python -m pytest evals/ -q\") or an \"eval\" npm script."
  elif [ -n "${CARJA_SKIP_EVAL:-}" ]; then
    carja_log_waiver "$PROJECT_ROOT" "EVAL" "$CARJA_SKIP_EVAL"
    echo "⚠️  Carja Eval-Driven Law (run) WAIVED: $CARJA_SKIP_EVAL"
    echo "    (logged to carja/0-compass/ship-log.md)"
  else
    echo "🧪 Carja Eval-Driven Law — running evals: $eval_cmd"
    if ( cd "$ROOT" && eval "$eval_cmd" ); then
      echo "✅ Evals passed."
    else
      echo ""
      echo "🛑 Evals FAILED — push blocked."
      echo "   Tests being green is not enough — the non-deterministic surface regressed."
      echo "   Fix the evalset, or bypass explicitly: CARJA_SKIP_EVAL=\"why\" git push …"
      exit 1
    fi
  fi
fi

echo "✅ Push allowed."
exit 0
